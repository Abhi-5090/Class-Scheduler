# ── Class Scheduler backend configuration ──
# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Signing key for the admin session cookie. Rotating it logs the admin out.
JWT_SECRET=<long random string>

# The single admin account, hashed into MongoDB on first boot.
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<change before going live>

PORT=4000
# The board's address(es), comma-separated. Only these sites may call the API
# with the admin session. In development any localhost port is also allowed.
CLIENT_ORIGIN=http://localhost:5180

# Timezone that decides "today" for batch start/end dates (default Asia/Kolkata).
# APP_TZ=Asia/Kolkata

# Set to production when deployed: secure cookies + trusting the host's proxy.
# NODE_ENV=production

# ── Email notifications ("Save & notify trainers") ──
# Leave unset to log notifications without sending them.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=timetable@college.edu
# SMTP_PASS=app-password-here
# MAIL_FROM="Class Scheduler <timetable@college.edu>"

# Proxies in front of the API (for the login rate limiter's IP).
# Render alone: 1 (default in production). Frontend relaying /api through Vercel: 2.
# TRUST_PROXY=1
